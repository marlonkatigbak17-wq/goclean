generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  brand                 String
  category              String
  subcategory           String
  price                 Float
  priceWithInstallation Float?
  images                String[]
  specs                 Json
  inStock               Boolean  @default(true)
  badge                 String?
  description           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  password         String
  phone            String    @default("")
  unitModel        String    @default("")
  installationDate DateTime?
  warrantyExpiry   DateTime?
  notes            String    @default("")
  createdAt        DateTime  @default(now())
  orders           Order[]
  bookings         Booking[]
  reviews          ProductReview[]
  address          Address?
}

model Booking {
  id                  String      @id @default(cuid())
  userId              String?
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  technicianId        String?
  technician          Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  name                String
  email               String
  phone               String
  address             String
  service             String
  preferredDate       String
  notes               String      @default("")
  adminNotes          String      @default("")
  status              String      @default("pending")
  unitModel           String      @default("")
  installationDate    String      @default("")
  partsUsed           Json?
  photos              String[]
  rebookReminderSent  Boolean     @default(false)
  createdAt           DateTime    @default(now())
}

model Technician {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String    @default("")
  password  String
  active    Boolean   @default(true)
  lastLat   Float?
  lastLng   Float?
  lastSeen  DateTime?
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Lead {
  id         String      @id @default(cuid())
  name       String
  email      String      @default("")
  phone      String
  source     String      @default("website")
  service    String      @default("")
  notes      String      @default("")
  status     String      @default("new")
  quotations Quotation[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Quotation {
  id            String   @id @default(cuid())
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String   @default("")
  customerPhone String   @default("")
  items         Json
  subtotal      Float
  discount      Float    @default(0)
  total         Float
  status        String   @default("draft")
  notes         String   @default("")
  validUntil    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Address {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  street   String @default("")
  city     String @default("")
  province String @default("")
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   @default("percentage")
  discountValue Float
  minOrder      Float    @default(0)
  maxUses       Int?
  usedCount     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model ProductReview {
  id           String   @id @default(cuid())
  productSlug  String
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName String
  rating       Int
  comment      String
  createdAt    DateTime @default(now())
}

model JobApplication {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String
  address          String
  position         String
  experience       String
  canDrive         Boolean  @default(false)
  startImmediately Boolean  @default(false)
  resumeUrl        String?
  certUrls         String[]
  coverLetter      String   @default("")
  status           String   @default("new")
  adminNotes       String   @default("")
  score            Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Order {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String   @unique
  customerName  String
  customerEmail String
  customerPhone String   @default("")
  address       String   @default("")
  notes         String   @default("")
  adminNotes    String   @default("")
  items         Json
  total         Float
  status        String   @default("paid")
  createdAt     DateTime @default(now())
}


model SocialPost {
  id          String    @id @default(cuid())
  caption     String
  hashtags    String    @default("")
  mediaUrls   Json      @default("[]")
  postType    String    @default("service")
  notes       String    @default("")
  scheduledAt DateTime
  publishedAt DateTime?
  status      String    @default("scheduled")
  fbPostId    String?
  createdAt   DateTime  @default(now())
}

model MessengerConversation {
  id          String   @id @default(cuid())
  senderId    String   @unique
  lastMessage String   @default("")
  paused      Boolean  @default(false)
  pausedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TechProLicense {
  id            String    @id @default(cuid())
  key           String    @unique
  plan          String    @default("monthly")   // monthly | yearly
  amount        Float
  phone         String
  email         String?
  name          String?
  paymentId     String?   @unique               // PayMongo payment ID
  activatedAt   DateTime?
  expiresAt     DateTime?
  isActive      Boolean   @default(false)
  deviceId      String?                          // locked to one device after first use
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
